// GMLiteSearch Tutorial - Chapter 7 Dataset
// 45 in-world lore/encyclopedia entries with genuinely long, multi-sentence
// descriptions (needed for snippet extraction to have real material to work with).
// Used throughout Chapter 7 to demonstrate snippet generation strategies and
// query understanding features.
//
// Usage:
//   var lore_entries = chapter7_get_lore_entries();
//   for (var i = 0; i < array_length(lore_entries); i++) {
//       var entry = lore_entries[i];
//       gmls_add_document_weighted(entry.id, entry.text, { title: entry.name, tags: [], timestamp: current_time });
//   }

function chapter7_get_lore_entries() {
    return [
        { id: "lore_001", name: "The Ashen Wyrm", text: "The Ashen Wyrm is an ancient dragon said to have slumbered beneath the Cinder Mountains for over a thousand years. Scholars believe it once ruled the volcanic peaks before the great eruption that buried its lair in ash. Local legends claim the wyrm's breath can turn stone to glass, and that its scales are harder than tempered steel. Several expeditions have attempted to locate its resting place, though none have returned with conclusive evidence. The most recent survey, conducted by the Cartographer's Guild, mapped extensive tunnel systems beneath the mountains but found no trace of the creature itself." },
        { id: "lore_002", name: "The Sunken City of Velmora", text: "Velmora was once the crown jewel of the coastal trading empire, a city of marble towers and canal streets that rivaled any capital on the continent. According to historical records, the city sank beneath the waves during the Great Tide of the third century, an event still poorly understood by modern scholars. Divers occasionally recover artifacts from the ruins, including coins, pottery, and fragments of the famous Velmoran tapestries. The sunken ruins are now home to schools of luminescent fish that locals call the Velmoran Lights, said to glow brightest on the anniversary of the city's fall." },
        { id: "lore_003", name: "Frostmane Elk", text: "The Frostmane Elk is a massive herbivore native to the northern tundra, distinguished by its pale antlers and thick frost-resistant coat. Herds migrate seasonally between the highland plains and the sheltered valleys, a journey that can span hundreds of miles. Hunters prize the elk for both its meat and its antlers, which are used in traditional northern crafts. The species was once believed extinct after a harsh string of winters decades ago, but recent surveys confirm a slowly recovering population in the more remote valleys." },
        { id: "lore_004", name: "The Order of the Silver Quill", text: "The Order of the Silver Quill is a scholarly organization dedicated to the preservation of historical texts and the documentation of the realm's ongoing history. Founded three centuries ago by a coalition of librarians and traveling scribes, the order maintains archives in every major city and sends scholars to document significant events as they unfold. Membership requires a rigorous apprenticeship, and full scribes are recognizable by their distinctive silver quill pins. The order has occasionally clashed with ruling authorities over its insistence on documenting uncomfortable truths alongside official narratives." },
        { id: "lore_005", name: "Thornwood Forest", text: "Thornwood Forest is a dense, ancient woodland known for its thorned undergrowth and unusually intelligent wildlife. Travelers are advised to stay on marked paths, as the forest's interior is notoriously easy to become lost within, with some claiming the trees themselves seem to shift when unobserved. The forest is home to several rare plant species used in traditional medicine, as well as a population of fox-like creatures locals call thornlings, known for their curious and occasionally mischievous behavior toward travelers who leave food unattended." },
        { id: "lore_006", name: "The Shattering of the First Throne", text: "The Shattering of the First Throne refers to the civil conflict that ended the original unified kingdom nearly five hundred years ago. Historical accounts vary considerably depending on which successor kingdom produced them, but most agree the conflict began as a succession dispute following the death of the last unified monarch. The war lasted almost a decade and resulted in the fractured political map that persists in the region today. The ruins of the original throne room can still be visited, though the throne itself was reportedly destroyed during the final siege." },
        { id: "lore_007", name: "Ember Foxes", text: "Ember Foxes are small, fire-adapted creatures found near volcanic regions, distinguished by their glowing orange fur and unusually warm body temperature. Despite their fiery appearance, they pose little danger to travelers and are generally shy, fleeing rather than confronting larger creatures. Local folklore holds that spotting an Ember Fox brings good luck, particularly to travelers about to undertake a long journey. Naturalists remain divided on whether the foxes' warmth is a natural adaptation to their volcanic habitat or something more unusual, given their apparent immunity to open flame." },
        { id: "lore_008", name: "The Whispering Archive", text: "The Whispering Archive is a subterranean library rumored to contain texts from civilizations that predate recorded history. Access is tightly restricted by the Order of the Silver Quill, who maintain that only a handful of scholars have ever been granted full access to its deepest chambers. Visitors report an unusual acoustic phenomenon within the archive's oldest section, where sounds seem to carry and echo in ways that defy the chamber's modest size, giving the archive its name. Several theories attempt to explain the phenomenon, ranging from unusual stone composition to more speculative magical explanations." },
        { id: "lore_009", name: "Duskharbor", text: "Duskharbor is a fishing town built along a naturally sheltered bay, known for its distinctive lantern-lit docks that stay illuminated through the night to guide returning fishing vessels. The town's economy depends heavily on its fishing fleet, though in recent decades it has also become a modest hub for trade with the outlying island communities. Duskharbor's most famous export is a preserved fish delicacy unique to the region, prepared using a salting technique passed down through generations of local families. The town hosts an annual lantern festival celebrating the safe return of its fleet each autumn." },
        { id: "lore_010", name: "The Cartographer's Guild", text: "The Cartographer's Guild is responsible for producing and maintaining the most accurate maps of the known realm, employing surveyors who regularly venture into unmapped or poorly documented territories. Guild-certified maps are considered the gold standard for navigation, trade planning, and military strategy alike. Membership is highly competitive, requiring years of fieldwork before a surveyor can achieve full certification. The guild maintains a central archive of historical maps, allowing scholars to track how borders, settlements, and even geographic features have shifted over the centuries." },
        { id: "lore_011", name: "Moonpetal Blossoms", text: "Moonpetal Blossoms are rare flowers that only open under moonlight, closing completely during daylight hours regardless of weather or season. They grow almost exclusively in high-altitude meadows with minimal exposure to direct sunlight, making them difficult to cultivate outside their natural habitat. Alchemists prize moonpetal extract for its use in sleep-inducing tonics, though the flower's rarity keeps such remedies expensive. Local tradition holds that a bouquet of moonpetals given under a full moon carries romantic significance, a custom that has driven modest but persistent demand among travelers passing through moonpetal-growing regions." },
        { id: "lore_012", name: "The Ironback Tortoises", text: "The Ironback Tortoise is a massive, slow-moving reptile known for its naturally metallic-hued shell, which some ironback populations develop a genuine mineral coating on over many decades of life in mineral-rich soil. Fully grown specimens can live for well over a century, and their shells are occasionally recovered and repurposed by craftsmen after the animal's natural death, though killing an ironback for its shell is illegal in most territories. The tortoises are herbivorous and largely indifferent to human presence, making them a popular, if unhurried, attraction for travelers passing through their grazing territories." },
        { id: "lore_013", name: "The Fall of House Ashgrove", text: "House Ashgrove was once among the most powerful noble families in the region, controlling significant agricultural land and holding considerable influence at court. The family's decline began following a series of poor harvests and mounting debts, culminating in the loss of most of their ancestral holdings within a single generation. Historical accounts differ on whether mismanagement or simple misfortune bears greater responsibility for the family's collapse. Descendants of House Ashgrove reportedly still live in the region, though none currently hold titles or land connected to their historical name." },
        { id: "lore_014", name: "Glimmerwing Moths", text: "Glimmerwing Moths are nocturnal insects known for the faint bioluminescent patterns along their wings, which flicker in irregular patterns during flight. Large swarms occasionally gather near forest clearings on warm summer nights, creating a natural light display that draws visitors from surrounding settlements. The moths themselves are harmless and feed exclusively on a specific flowering plant found in temperate woodlands. Some alchemists have experimented with harvesting the bioluminescent compound for use in low-light applications, though results have so far proven inconsistent and difficult to replicate reliably." },
        { id: "lore_015", name: "The Sundering Wastes", text: "The Sundering Wastes are a vast expanse of cracked, barren terrain believed to have been created by an ancient magical catastrophe of uncertain origin. The ground itself is unstable in many areas, with deep fissures that make travel across the wastes genuinely dangerous without an experienced guide. Despite the harsh conditions, several hardy plant and animal species have adapted to life in the wastes, and occasional expeditions still venture in search of artifacts believed to have been scattered by whatever event originally created the region." },
        { id: "lore_016", name: "Brackenhollow Village", text: "Brackenhollow is a small farming village nestled at the edge of Thornwood Forest, known for producing some of the region's finest root vegetables thanks to unusually fertile soil. The village maintains a wary but generally peaceful relationship with the forest's more unusual wildlife, including the thornlings that occasionally wander into the village outskirts. Brackenhollow's modest size belies its historical significance as a waypoint on the old trade route connecting the coastal cities to the northern highlands, a role it still fills for travelers today." },
        { id: "lore_017", name: "The Hollow Crown Legend", text: "The Hollow Crown is a legendary artifact said to grant its wearer unusual insight into the thoughts and intentions of others, though at a steep personal cost that varies depending on which version of the legend is told. Most accounts agree the crown was lost sometime during the Shattering of the First Throne, and numerous expeditions over the centuries have failed to recover it. Skeptical historians note that no verified physical evidence of the crown's existence has ever surfaced, suggesting it may be entirely mythical, while others point to fragmentary references in older texts as evidence of a genuine, if lost, artifact." },
        { id: "lore_018", name: "Tidecaller Whales", text: "Tidecaller Whales are massive marine mammals known for their distinctive low-frequency calls, which some fishing communities believe correlate with unusually favorable tidal patterns, though the scientific basis for this belief remains unconfirmed. The whales migrate along established routes each year, and their arrival is celebrated in several coastal communities as a sign of a prosperous fishing season ahead. Conservation efforts in recent decades have focused on protecting known migration corridors from increased shipping traffic, with cautiously encouraging results reported by several coastal monitoring stations." },
        { id: "lore_019", name: "The Scribe's Rebellion", text: "The Scribe's Rebellion was a brief but historically significant uprising led by members of the Order of the Silver Quill against a ruling authority that had attempted to suppress the publication of an unflattering historical account. Though the rebellion itself was quickly and peacefully resolved through negotiation, it established an important precedent regarding the order's independence from political interference. The event is commemorated annually within the order, and the disputed historical account in question is now considered required reading for all full scribes." },
        { id: "lore_020", name: "Cinderbloom Trees", text: "Cinderbloom Trees are unusual flora found exclusively in volcanic regions, capable of surviving temperatures that would kill most other plant life thanks to a naturally heat-resistant bark. Their blossoms, which appear only once every several years, are prized by alchemists for their rare medicinal properties. Local communities near volcanic regions have developed careful harvesting traditions to avoid depleting wild cinderbloom populations, since cultivated specimens outside their natural volcanic habitat have so far proven impossible to grow successfully." },
        { id: "lore_021", name: "The Drowned Library", text: "The Drowned Library refers to a partially submerged archive believed to be connected to the ruins of Velmora, accessible only during periods of unusually low tide. Divers and scholars who have explored the accessible chambers report finding waterlogged but occasionally legible texts, though the library's full extent remains unmapped due to the danger of exploring its deeper, permanently flooded sections. The Order of the Silver Quill has expressed considerable interest in a coordinated expedition, though funding and safety concerns have repeatedly delayed any serious attempt." },
        { id: "lore_022", name: "Highland Sheepherders", text: "Highland Sheepherders are a semi-nomadic community that has tended flocks across the northern highland plains for as long as recorded history extends in the region. Their distinctive woven textiles, made from the wool of hardy highland sheep breeds, are recognized and traded throughout the realm. The community maintains a strong oral tradition, passing down navigation knowledge of the highland terrain through generations rather than written maps, a practice that has occasionally put them at odds with the more map-dependent Cartographer's Guild." },
        { id: "lore_023", name: "The Obsidian Gate", text: "The Obsidian Gate is an imposing volcanic rock formation that marks the traditional boundary between the Cinder Mountains and the surrounding lowlands. Local legend holds that the gate was formed during the same eruption that buried the Ashen Wyrm's lair, though geological surveys suggest the formation likely predates that event by a significant margin. The gate has become a popular, if physically demanding, destination for travelers seeking a dramatic vantage point over the volcanic region." },
        { id: "lore_024", name: "Rootbound Sprites", text: "Rootbound Sprites are small forest-dwelling creatures said to bond permanently with a single tree for the entirety of their unusually long lifespan, rarely straying more than a short distance from their chosen home. Sightings are considered rare and fortunate, and thornlings are said to avoid trees known to host a rootbound sprite, suggesting some form of mutual recognition between the forest's more unusual inhabitants. Little formal scholarship exists on the species, with most accounts coming from traveler folklore rather than rigorous naturalist study." },
        { id: "lore_025", name: "The Salt Road", text: "The Salt Road is an ancient trade route connecting the coastal salt flats to the inland highland communities, historically used to transport preserved goods and salt itself across considerable distances. Though largely superseded by more efficient modern trade routes, sections of the Salt Road remain in use by highland sheepherders and other travelers familiar with its more direct, if physically demanding, mountain passes. Several waystations along the route, though abandoned, still provide reliable shelter for travelers willing to brave the older path." },
        { id: "lore_026", name: "Duskwing Bats", text: "Duskwing Bats are a common nocturnal species found throughout temperate forest regions, notable primarily for their unusually large colonies, which can number in the tens of thousands within a single cave system. Farmers generally welcome duskwing colonies near their land, as the bats consume large quantities of crop-damaging insects each night. Occasional conflicts arise when colonies establish themselves in structurally significant locations, such as the bell towers of village chapels, requiring careful and humane relocation efforts." },
        { id: "lore_027", name: "The Founding Accord", text: "The Founding Accord refers to the diplomatic agreement that formally established the current arrangement of successor kingdoms following the chaos of the Shattering of the First Throne. Negotiated over several years by representatives from each emerging faction, the accord established borders that, with only minor adjustments, remain largely intact today. Historians generally credit the accord's careful, deliberately ambiguous language on several contentious points as a key factor in its surprising durability across the centuries since its signing." },
        { id: "lore_028", name: "Silverbrook Trout", text: "Silverbrook Trout are a prized freshwater fish species native to the cold mountain streams feeding into the region's major river systems, known for their distinctive silvery scales and notably delicate flavor. Fishing rights along the most productive silverbrook streams are carefully regulated, with several highland communities maintaining traditional, generations-old agreements governing seasonal access. The species has become something of a culinary export, with preserved silverbrook trout occasionally reaching markets in Duskharbor and other coastal towns." },
        { id: "lore_029", name: "The Marrow Caverns", text: "The Marrow Caverns are an extensive underground cave system beneath the highland plains, named for the unusual pale mineral formations that some early explorers thought resembled bone. The caverns have never been fully mapped, and several sections remain inaccessible due to structural instability or flooding. Highland sheepherders traditionally avoid the caverns, citing old warnings passed down through their oral tradition, though no confirmed dangers beyond the caves' natural structural risks have ever been formally documented." },
        { id: "lore_030", name: "The Lantern Festival", text: "The Lantern Festival is an annual celebration held in Duskharbor each autumn, commemorating the safe return of the town's fishing fleet before the onset of winter storms. The festival's centerpiece is a procession of illuminated paper lanterns released into the harbor at dusk, a tradition believed to have originated as a practical signal for returning ships before evolving into its modern ceremonial form. Visitors from surrounding communities regularly travel to Duskharbor specifically to witness the festival, making it one of the town's most significant annual sources of visitor trade." },
        { id: "lore_031", name: "Ashfall Ironwood", text: "Ashfall Ironwood is an unusually dense timber harvested from a specific tree species that grows only in the volcanic soil surrounding the Cinder Mountains. The wood's exceptional density and heat resistance make it highly prized for both construction and craftsmanship, though its weight and difficulty to work limit its broader use. Ironwood harvesting is a dangerous, specialized trade, requiring workers to venture into terrain that remains geologically active, and the wood commands correspondingly high prices in markets throughout the realm." },
        { id: "lore_032", name: "The Weeping Statues", text: "The Weeping Statues are a set of ancient stone figures found scattered throughout the Sundering Wastes, notable for an unusual mineral seepage that gives the appearance of tears running down their weathered faces. Their original purpose and the identity of their sculptors remain unknown, though their consistent artistic style suggests a single, coordinated origin rather than independent creation. Several scholars from the Order of the Silver Quill have proposed connections to the same catastrophic event believed to have created the wastes themselves, though no conclusive evidence has yet confirmed this theory." },
        { id: "lore_033", name: "Windward Cliffs", text: "The Windward Cliffs form a dramatic coastal boundary along the western edge of the realm, known for consistently powerful winds that have shaped both the landscape and the unusual, wind-resistant vegetation that clings to the exposed rock faces. The cliffs are a popular, if hazardous, destination for travelers seeking dramatic ocean views, and several fatal accidents over the years have prompted local authorities to install warning markers along the most treacherous approach paths." },
        { id: "lore_034", name: "The Copperlight Mines", text: "The Copperlight Mines were once among the most productive metal extraction sites in the region, though declining ore quality led to their gradual abandonment over the past several decades. The mines are named for the distinctive copper-hued glow that early miners reported seeing deep within certain tunnel sections, a phenomenon later attributed to mineral deposits reacting with groundwater rather than anything more unusual. Portions of the mine complex remain structurally sound and occasionally attract prospectors hoping to locate overlooked deposits." },
        { id: "lore_035", name: "Nightbloom Ivy", text: "Nightbloom Ivy is a fast-growing climbing plant notable for flowers that release a faint, pleasant fragrance exclusively after nightfall, closing completely during daylight hours much like the rarer moonpetal blossom, though nightbloom is considerably more common and easier to cultivate. The ivy is a popular ornamental choice for gardens throughout the realm, prized for the way its evening fragrance transforms an otherwise ordinary courtyard after dark. Some households cultivate nightbloom specifically along walking paths for this reason." },
        { id: "lore_036", name: "The Riverkeep Bridges", text: "The Riverkeep Bridges are a series of stone crossings spanning the region's major river system, several of which date back to the era before the Shattering of the First Throne and remain remarkably structurally sound despite their age. The bridges are maintained collectively by the communities on either bank, an arrangement that has occasionally required delicate diplomatic negotiation when those communities fall under different successor kingdoms' jurisdiction following border adjustments over the centuries." },
        { id: "lore_037", name: "Emberfall Peaks", text: "Emberfall Peaks refers to the highest points within the Cinder Mountains, named for the distinctive reddish glow the snow-capped summits take on during sunset, an effect caused by mineral dust carried on volcanic winds settling onto the exposed ice. The peaks remain largely unclimbed due to both the technical difficulty of the ascent and the region's ongoing volcanic activity, though a small community of dedicated mountaineers continues to attempt the summit each year." },
        { id: "lore_038", name: "The Quiet Accord Scholars", text: "The Quiet Accord Scholars are a specialized branch of the Order of the Silver Quill focused specifically on documenting and analyzing the terms and consequences of the Founding Accord and related historical treaties. Their work is considered essential reference material for diplomats and legal scholars throughout the successor kingdoms, and the branch maintains a reputation for scrupulous political neutrality even when documenting historically contentious diplomatic episodes." },
        { id: "lore_039", name: "Hollowreed Marshes", text: "The Hollowreed Marshes are an extensive wetland region known for the unusually tall, hollow-stemmed reeds that give the marshes their name, historically harvested by nearby communities for use in construction and basketweaving. The marshes support a rich variety of wildlife, including several bird species that migrate through the region seasonally, drawing modest but consistent interest from naturalists and birdwatchers willing to navigate the marsh's notoriously difficult terrain." },
        { id: "lore_040", name: "The Sailmaker's Guild", text: "The Sailmaker's Guild is a trade organization based primarily in Duskharbor, responsible for training and certifying sailmakers throughout the coastal region. Guild-certified sails are considered a mark of exceptional quality, and vessels equipped with them command noticeably higher resale value. The guild maintains strict apprenticeship standards, and full certification typically requires several years of supervised work before a sailmaker can operate independently under the guild's recognized mark." },
        { id: "lore_041", name: "Duskmoth Silk", text: "Duskmoth Silk is a rare textile produced from the cocoons of a specific moth species found only in the temperate forests near Brackenhollow, prized throughout the realm for its unusual, faintly shimmering quality under low light conditions. Harvesting duskmoth silk without harming the moth population requires specialized knowledge passed down through a small number of dedicated harvesting families, keeping supply consistently limited and prices correspondingly high in distant markets." },
        { id: "lore_042", name: "The Highland Accord", text: "The Highland Accord is a separate, more localized agreement between the highland sheepherding communities and the successor kingdom that formally administers the highland plains, establishing traditional grazing and migration rights that predate and remain distinct from the broader Founding Accord. The agreement is renewed ceremonially every generation, a practice that has helped maintain its legitimacy and continued relevance despite the informal, oral tradition-based nature of highland governance more broadly." },
        { id: "lore_043", name: "The Cindermoth Swarms", text: "Cindermoth Swarms are a seasonal phenomenon in which large numbers of a specific moth species, drawn by the warmth of volcanic vents, gather near the base of the Cinder Mountains in a dense, briefly spectacular display. Unlike the more commonly seen glimmerwing moths, cindermoths lack bioluminescence but are notable for their unusual heat tolerance, a trait naturalists believe evolved specifically to exploit the volcanic region's unique thermal environment relative to surrounding temperate zones." },
        { id: "lore_044", name: "The Old Coastal Watch", text: "The Old Coastal Watch refers to a now largely decommissioned network of signal towers that once provided early warning of approaching storms and, historically, hostile vessels along the realm's western coastline. Several towers remain standing and structurally intact, occasionally repurposed as scenic waypoints for travelers exploring the Windward Cliffs region, though their original signaling equipment was removed decades ago when more modern warning systems rendered the network obsolete." },
        { id: "lore_045", name: "Frostbloom Lichen", text: "Frostbloom Lichen is a slow-growing organism found exclusively in the coldest reaches of the northern highlands, notable for a distinctive blue-white coloration that intensifies during the harshest winter months. Highland sheepherders traditionally use frostbloom as a natural indicator of particularly severe weather approaching, timing their seasonal migrations partly around observed changes in the lichen's coloration, a practice modern meteorological monitoring has only partially been able to explain or replicate." }
    ];
}